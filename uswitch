# --- DDC/CI through ddcutil ---------------------------------------------------


def parse_getvcp(text):
    """The input source's low byte from `ddcutil --terse getvcp 60`, or None."""
    m = re.search(r"^VCP\s+60\s+\S+(.*)$", text, re.MULTILINE | re.IGNORECASE)
    if not m:
        return None
    values = re.findall(r"x([0-9a-fA-F]+)", m.group(1))
    if not values:
        return None
    return int(values[-1], 16) & 0xFF


class Ddc:
    def __init__(self, ctx):
        self.ctx = ctx

    def _run(self, connector, args):
        try:
            return self.ctx.command(["ddcutil", *connector.ddcutil_args(), *args])
        except MissingCommand:
            raise UswitchError(f"ddcutil is not installed; {DDCUTIL_PACKAGE_HINT}")

    def get_input(self, connector):
        """(value, None), or (None, why) when the monitor didn't answer."""
        r = self._run(connector, ["--terse", "getvcp", INPUT_SOURCE])
        if r.returncode != 0:
            return None, r.message()
        value = parse_getvcp(r.stdout)
        if value is None:
            return None, f"unexpected ddcutil output: {r.stdout.strip()[:80]!r}"
        return value, None

    def set_input(self, connector, value):
        """None, or why the write failed."""
        r = self._run(connector, ["setvcp", INPUT_SOURCE, f"0x{value:02x}"])
        return None if r.returncode == 0 else r.message()


