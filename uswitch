# Connectors of a laptop's own panel: no DDC/CI, and never part of a desk.
INTERNAL_CONNECTORS = ("eDP", "LVDS", "DSI")

# MCCS names for display only (D8); Dell puts USB-C at 0x1b.
INPUT_NAMES = {
    0x01: "VGA-1",
    0x02: "VGA-2",
    0x03: "DVI-1",
    0x04: "DVI-2",
    0x0F: "DisplayPort-1",
    0x10: "DisplayPort-2",
    0x11: "HDMI-1",
    0x12: "HDMI-2",
    0x1B: "USB-C",
}

# On a Mac, everything is the user's own (D15).
MAC_DIR = "Library/Application Support/mswitch"
M1DDC_HINT = "install it with `brew install m1ddc` (Apple silicon only)"
# m1ddc's EDID UUID, a Mac's identity for a monitor without a serial (D17).
UUID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
# IOKit's location ID, a Mac's port path: the bus in the top byte, then a hex
# digit per hub tier (D17).
LOCATION = re.compile(r"0x[0-9a-f]{8}")
# Mb/s for each of IOKit's USB speeds, as `ioreg` gives a device's "Device Speed".
IOKIT_SPEEDS = {0: 1.5, 1: 12.0, 2: 480.0, 3: 5000.0, 4: 10000.0, 5: 20000.0}

DDCUTIL_PACKAGE_HINT = "install the ddcutil package (apt install ddcutil, or dnf install ddcutil)"
ACPID_PACKAGE_HINT = (
    "install the acpid package (apt install acpid, or dnf install acpid), "
    "or set [power_button] enabled = no in /etc/uswitch.conf"
)

# Wakeup sources of the ACPI power button, in /sys/class/wakeup (D13).
POWER_BUTTON_SOURCES = ("PNP0C0C", "LNXPWRBN")
# What acpid reports for a power-button press, to find other handlers of it.
ACPID_POWER_EVENT = "button/power PBTN 00000080 00000000"
# acpid reads only event files with names like this.
ACPID_FILE_NAME = re.compile(r"[A-Za-z0-9_-]+")

HEX4 = re.compile(r"[0-9a-f]{4}")
PORT = re.compile(r"\d+-\d+(\.\d+)*")
DESK_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")
# A value safe inside a quoted udev match: printable ASCII with no quote,
# backslash or glob character, which would widen the match (D1).
UDEV_SAFE = re.compile(r"[\x20-\x7e]+")
UDEV_UNSAFE_CHARS = set('"\\*?[]|')


class UswitchError(Exception):
    """A failure to report to the user and exit on, with `code` as the status."""

    def __init__(self, message, code=1):
        super().__init__(message)
        self.code = code


class MissingCommand(UswitchError):
    pass


@dataclass(frozen=True)
class Timing:
    """The bounds every wait runs under (D12). Provisional until SPEC.md's
    Phase 0 measures real hardware; tune them from its numbers."""

    appear: float = 30.0  # for a configured monitor's EDID, after boot or resume
    run: float = 45.0  # a whole switch run, so a trigger returning mid-run is caught
    settle: float = 5.0  # after a write, before writing again or calling it unconfirmed
    poll: float = 0.25  # between checks
    learn_press: float = 120.0  # learn: for the devices to leave, then to return
    learn_return_grace: float = 5.0  # learn: after the first returns, for the rest
    learn_away: float = 30.0  # learn: for each monitor to leave this machine's input
    command: float = 20.0  # one ddcutil, systemctl, udevadm or modprobe call


class Clock:
    def now(self):
        return time.monotonic()

    def sleep(self, seconds):
        time.sleep(seconds)


@dataclass
class Result:
    returncode: int
    stdout: str
    stderr: str

    def message(self):
        text = (self.stderr.strip() or self.stdout.strip()).splitlines()
        return text[0] if text else f"exit status {self.returncode}"


def run_command(argv, timeout):
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)
    except FileNotFoundError:
        raise MissingCommand(f"{argv[0]} not found")
    except subprocess.TimeoutExpired:
        return Result(124, "", f"{argv[0]} timed out after {timeout:g}s")
    return Result(p.returncode, p.stdout, p.stderr)


@dataclass
class Context:
    """Everything uswitch touches outside itself, so tests can stand it in."""

    root: str = "/"
    sysfs: str = "/sys"
    clock: Clock = field(default_factory=Clock)
    run: object = run_command
    which: object = shutil.which
    euid: int = field(default_factory=os.geteuid)
    stdin: object = sys.stdin
    stdout: object = sys.stdout
    stderr: object = sys.stderr
    timing: Timing = field(default_factory=Timing)
    self_path: str = os.path.abspath(__file__)
    home: str = field(default_factory=lambda: os.path.expanduser("~"))
    platform: object = field(default_factory=lambda: Mac() if sys.platform == "darwin" else Linux())

    @property
    def live(self):
        """Whether this is the running system, rather than a root to write into."""
        return self.root == "/"

    def path(self, rel):
        return os.path.join(self.root, rel)

    def say(self, message):
        print(message, file=self.stdout, flush=True)

    def warn(self, message):
        print(f"{self.platform.name}: {message}", file=self.stderr, flush=True)

    def ask(self, prompt, default=""):
        shown = f"{prompt} [{default}] " if default else f"{prompt} "
        print(shown, end="", file=self.stdout, flush=True)
        line = self.stdin.readline()
        if not line:
            raise UswitchError("learn needs a terminal to answer its questions")
        return line.strip() or default

    def command(self, argv):
        return self.run(argv, self.timing.command)


def require_root(ctx):
    if ctx.live and ctx.euid != 0:
        raise UswitchError("this needs root: run it with sudo")


def input_name(value):
    if value is None:
        return "unknown"
    name = INPUT_NAMES.get(value)
    return f"0x{value:02x} ({name})" if name else f"0x{value:02x}"


# --- EDID and connected monitors (D6) ----------------------------------------

EDID_HEADER = bytes([0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00])


@dataclass(frozen=True)
class Edid:
    mfg: str
    model: str
    serial: str
    raw: bytes
    uuid: str = ""  # on a Mac, m1ddc's EDID UUID in place of the bytes (D17)

    @property
    def hex(self):
        return self.raw.hex()

    @property
    def key(self):
        """The whole EDID's identity, for a monitor without a serial (D6)."""
        return self.raw.hex() if self.raw else self.uuid.lower()


def _edid_text(block):
    text = block[5:18].split(b"\n", 1)[0]
    return "".join(chr(b) if 0x20 <= b < 0x7F else "?" for b in text).strip()


def parse_edid(data):
    """The identity in an EDID, or None if `data` isn't one."""
    if len(data) < 128 or data[:8] != EDID_HEADER:
        return None
    v = data[8] << 8 | data[9]
    mfg = "".join(chr(((v >> shift) & 0x1F) + 64) for shift in (10, 5, 0))
    model = serial = ""
    for offset in (54, 72, 90, 108):
        block = data[offset : offset + 18]
        if block[0] == 0 and block[1] == 0 and block[2] == 0:
            if block[3] == 0xFC:
                model = _edid_text(block)
            elif block[3] == 0xFF:
                serial = _edid_text(block)
    return Edid(mfg, model, serial, bytes(data[:128]))


@dataclass(frozen=True)
class Connector:
    """A connected external monitor as the kernel's DRM layer sees it."""

    name: str
    edid: Edid
    bus: object  # the connector's own I2C bus number, when the driver exposes it

    def ddcutil_args(self):
        # The connector's own bus is fastest; the EDID is exact otherwise.
        if self.bus is not None:
            return ["--bus", str(self.bus)]
        return ["--edid", self.edid.hex]


def _read(path, mode="r"):
    with open(path, mode) as f:
        return f.read()


def _connector_bus(path):
    ddc = os.path.join(path, "ddc")
    candidates = []
    if os.path.islink(ddc):
        candidates.append(os.path.basename(os.readlink(ddc)))
    try:
        candidates += sorted(n for n in os.listdir(path) if n.startswith("i2c-"))
    except OSError:
        return None  # the connector vanished mid-hotplug; the caller re-polls
    for name in candidates:
        m = re.fullmatch(r"i2c-(\d+)", name)
        if m:
            return int(m.group(1))
    return None


def connected_monitors(sysfs):
    """Every connected external monitor with a readable EDID."""
    base = os.path.join(sysfs, "class", "drm")
    try:
        names = sorted(os.listdir(base))
    except FileNotFoundError:
        return []
    found = []
    for name in names:
        if "-" not in name:
            continue  # card0 itself, renderD128
        if name.split("-", 1)[1].startswith(INTERNAL_CONNECTORS):
            continue
        path = os.path.join(base, name)
        try:
            if _read(os.path.join(path, "status")).strip() != "connected":
                continue
            edid = parse_edid(_read(os.path.join(path, "edid"), "rb"))
        except OSError:
            continue  # sysfs entries come and go during hotplug; the caller re-polls
        if edid is not None:
            found.append(Connector(name, edid, _connector_bus(path)))
    return found


# --- USB devices (D1) --------------------------------------------------------


@dataclass(frozen=True)
class UsbDevice:
    port: str  # the kernel name, its port path ("3-2", "3-2.1"); on a Mac, its location ID
    vendor: str
    product: str
    serial: str
    name: str
    hub: bool
    speed: float  # Mb/s
    # The bus's number for this enumeration: it changes whenever the device
    # re-enumerates, so a press away and back shows even if nobody saw it gone.
    devnum: int = field(default=0, compare=False)

    @property
    def depth(self):
        if LOCATION.fullmatch(self.port):
            return len(self.port[4:].split("0")[0])  # a digit per hub tier, then zeros
        return 1 + self.port.count(".")

    def describe(self):
        serial = f" serial {self.serial}" if self.serial else ""
        name = f" {self.name}" if self.name else ""
        return f"{self.vendor}:{self.product}{serial} at {self.port}{name}"


def _attr(path, name):
    try:
        return _read(os.path.join(path, name)).strip()
    except OSError:
        return ""  # an optional attribute (serial, product strings) a device needn't have


def usb_devices(sysfs):
    """Every USB device but root hubs, by port."""
    base = os.path.join(sysfs, "bus", "usb", "devices")
    try:
        names = os.listdir(base)
    except FileNotFoundError:
        return {}
    devices = {}
    for name in names:
        if ":" in name or name.startswith("usb") or not PORT.fullmatch(name):
            continue  # interfaces, and root hubs, which never come and go with a switch
        path = os.path.join(base, name)
        vendor = _attr(path, "idVendor")
        if not vendor:
            continue  # gone between the listing and the read
        try:
            speed = float(_attr(path, "speed") or 0)
        except ValueError:
            speed = 0.0
        label = " ".join(s for s in (_attr(path, "manufacturer"), _attr(path, "product")) if s)
        devnum = _attr(path, "devnum")
        devices[name] = UsbDevice(
            port=name,
            vendor=vendor.lower(),
            product=_attr(path, "idProduct").lower(),
            serial=_attr(path, "serial"),
            name=label,
            hub=_attr(path, "bDeviceClass") == "09",
            speed=speed,
            devnum=int(devnum) if devnum.isdigit() else 0,
        )
    return devices


def udev_safe(value):
    return bool(UDEV_SAFE.fullmatch(value)) and not (set(value) & UDEV_UNSAFE_CHARS)


@dataclass(frozen=True)
class UsbTrigger:
    vendor: str
    product: str
    serial: str = ""
    port: str = ""

    def matches(self, device):
        return (
            device.vendor == self.vendor
            and device.product == self.product
            and (not self.serial or device.serial == self.serial)
            and (not self.port or device.port == self.port)
        )

    def present(self, devices):
        return any(self.matches(d) for d in devices.values())

    def generation(self, devices):
        """Which enumeration of the trigger is here: empty when it's absent, and
        different after any press away and back, however brief (D12)."""
        return frozenset((d.port, d.devnum) for d in devices.values() if self.matches(d))

    def describe(self):
        parts = [f"{self.vendor}:{self.product}"]
        if self.serial:
            parts.append(f"serial {self.serial}")
        if self.port:
            parts.append(f"port {self.port}")
        return " ".join(parts)

    def validate(self, where):
        if not HEX4.fullmatch(self.vendor) or not HEX4.fullmatch(self.product):
            raise UswitchError(f"{where}: usb_vendor and usb_product must be four hex digits")
        if self.serial and not udev_safe(self.serial):
            raise UswitchError(f"{where}: usb_serial has characters a udev rule can't match safely")
        if self.port and not (PORT.fullmatch(self.port) or LOCATION.fullmatch(self.port)):
            raise UswitchError(f"{where}: usb_port must look like 3-2 or 3-2.1 (on a Mac, a location ID like 0x14100000)")


def trigger_for(device, devices):
    """The trigger matching `device` alone among `devices` (D1)."""
    serial = device.serial if device.serial and udev_safe(device.serial) else ""
    trigger = UsbTrigger(device.vendor, device.product, serial)
    others = [d for d in devices.values() if d.port != device.port and trigger.matches(d)]
    if others or (device.serial and not serial):
        trigger = dataclasses.replace(trigger, port=device.port)
    return trigger


def trigger_candidates(returned):
    """The devices that left and came back closest to the root port,
    preferring a hub, and of a USB 3 hub's pair the USB 2 half (D1, D2)."""
    if not returned:
        return []
    depth = min(d.depth for d in returned)
    top = [d for d in returned if d.depth == depth]
    hubs = [d for d in top if d.hub]
    top = hubs or top
    slow = [d for d in top if 0 < d.speed <= 480]
    return sorted(slow or top, key=lambda d: d.port)


# --- Configuration (D11) -----------------------------------------------------


@dataclass
class Monitor:
    label: str
    desk: str
    mfg: str
    model: str
    serial: str
    edid: str  # the whole EDID in hex (a Mac's EDID UUID), the identity without a serial
    input: int

    def matches(self, edid):
        if self.serial:
            return (edid.mfg, edid.model, edid.serial) == (self.mfg, self.model, self.serial)
        return edid.key == self.edid

    def same_monitor(self, other):
        if self.serial or other.serial:
            return (self.mfg, self.model, self.serial) == (other.mfg, other.model, other.serial)
        return self.edid == other.edid


def monitor_from_edid(edid, desk, value):
    # Without a serial the whole EDID is the identity, so the label hashes all of it:
    # two same-model monitors can differ in any byte, the manufacture week say.
    whole = edid.raw or edid.uuid.lower().encode()
    ident = edid.serial or f"edid {hashlib.sha256(whole).hexdigest()[:12]}"
    label = re.sub(r"[\[\]]", "", " ".join(s for s in (edid.model or edid.mfg, ident) if s))
    return Monitor(
        label=label,
        desk=desk,
        mfg=edid.mfg,
        model=edid.model,
        serial=edid.serial,
        edid="" if edid.serial else edid.key,
        input=value,
    )


@dataclass
class Desk:
    name: str
    usb: object = None  # a UsbTrigger at a setup A desk; None at setup B


@dataclass
class Config:
    wake: bool = True
    power_button: bool = True
    desks: dict = field(default_factory=dict)
    monitors: list = field(default_factory=list)

    def monitors_of(self, desk):
        return [m for m in self.monitors if m.desk == desk]


def load_config(path):
    """The configuration at `path`, or None if there is none."""
    parser = configparser.ConfigParser(interpolation=None)
    try:
        with open(path) as f:
            parser.read_file(f)
    except FileNotFoundError:
        return None
    except (OSError, configparser.Error) as e:
        raise UswitchError(f"can't read {path}: {e}")
    config = Config()
    try:
        if parser.has_section("wake"):
            config.wake = parser.getboolean("wake", "enabled", fallback=True)
        if parser.has_section("power_button"):
            config.power_button = parser.getboolean("power_button", "enabled", fallback=True)
        for section in parser.sections():
            kind, _, name = section.partition(" ")
            values = parser[section]
            if kind == "desk":
                if not DESK_NAME.fullmatch(name):
                    raise UswitchError(f"{path}: [{section}]: desk names are letters, digits, '.', '_', '-'")
                usb = None
                if values.get("usb_vendor") or values.get("usb_product"):
                    usb = UsbTrigger(
                        values.get("usb_vendor", "").lower(),
                        values.get("usb_product", "").lower(),
                        values.get("usb_serial", ""),
                        values.get("usb_port", "").lower(),
                    )
                    usb.validate(f"{path}: [{section}]")
                config.desks[name] = Desk(name, usb)
            elif kind == "monitor":
                config.monitors.append(
                    Monitor(
                        label=name,
                        desk=values.get("desk", ""),
                        mfg=values.get("mfg", ""),
                        model=values.get("model", ""),
                        serial=values.get("serial", ""),
                        edid=values.get("edid", "").lower(),
                        input=int(values.get("input", ""), 0),
                    )
                )
            elif section not in ("wake", "power_button"):
                raise UswitchError(f"{path}: unknown section [{section}]")
    except ValueError as e:
        raise UswitchError(f"{path}: {e}")
    for m in config.monitors:
        if m.desk not in config.desks:
            raise UswitchError(f"{path}: [monitor {m.label}] names desk {m.desk!r}, which has no [desk] section")
        if not m.serial and not (re.fullmatch(r"[0-9a-f]{256}", m.edid) or UUID.fullmatch(m.edid)):
            raise UswitchError(f"{path}: [monitor {m.label}] needs a serial or its whole EDID (on a Mac, its EDID UUID)")
    return config


def _clean(value):
    if "\n" in value or "\r" in value:
        raise UswitchError(f"refusing to write a value with a line break: {value!r}")
    return value


def config_text(config, platform=None):
    platform = platform or Linux()
    settings = "[wake] or [power_button]" if platform.power_button else "[wake]"
    lines = [
        f"# Written by {platform.name} learn: rerun it rather than editing by hand (SPEC.md,",
        f"# Configuration). After changing {settings}, rerun",
        f"# `{platform.install_command}`.",
        "",
        "[wake]",
        f"enabled = {'yes' if config.wake else 'no'}",
    ]
    if platform.power_button:
        lines += ["", "[power_button]", f"enabled = {'yes' if config.power_button else 'no'}"]
    for name in sorted(config.desks):
        desk = config.desks[name]
        lines += ["", f"[desk {_clean(name)}]"]
        if desk.usb:
            lines += [
                f"usb_vendor = {desk.usb.vendor}",
                f"usb_product = {desk.usb.product}",
                f"usb_serial = {_clean(desk.usb.serial)}",
                f"usb_port = {desk.usb.port}",
            ]
        else:
            lines.append("# No USB switch: the monitor is the switch (setup B).")
    labels = [m.label for m in config.monitors]
    if len(set(labels)) != len(labels):
        raise UswitchError("two monitors would share a [monitor] section; refusing to write the configuration")
    for m in sorted(config.monitors, key=lambda m: (m.desk, m.label)):
        lines += [
            "",
            f"[monitor {_clean(m.label)}]",
            f"desk = {m.desk}",
            f"mfg = {_clean(m.mfg)}",
            f"model = {_clean(m.model)}",
            f"serial = {_clean(m.serial)}",
        ]
        if m.edid:
            lines.append(f"edid = {m.edid}")
        if m.input in INPUT_NAMES:
            lines.append(f"# {INPUT_NAMES[m.input]}")
        lines.append(f"input = 0x{m.input:02x}")
    return "\n".join(lines) + "\n"


def write_file(path, text, mode=0o644):
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".uswitch-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def replace_desk(config, name, usb, monitors):
    """`config` with desk `name` holding exactly `monitors` (D11): learning a
    monitor at another desk moves it, and a desk left empty goes."""
    kept = [m for m in config.monitors if m.desk != name and not any(m.same_monitor(n) for n in monitors)]
    for m in monitors:
        m.desk = name
    desks = {n: d for n, d in config.desks.items() if n != name}
    desks[name] = Desk(name, usb)
    monitors_by_desk = {m.desk for m in kept} | {name}
    desks = {n: d for n, d in desks.items() if n in monitors_by_desk}
    return dataclasses.replace(config, desks=desks, monitors=kept + list(monitors))


# --- Generated system files (D3, D4, D9, D10) ---------------------------------


def udev_rules_text(config, systemctl):
    lines = [
        "# Written by uswitch learn from /etc/uswitch.conf; rewritten on every learn.",
        "# One line per learned USB switch: when its hub appears, start uswitch.service",
        "# (SPEC.md D1, D3). udev never runs uswitch itself.",
    ]
    by_line = {}
    for name in sorted(config.desks):
        usb = config.desks[name].usb
        if usb is None:
            continue
        usb.validate(f"desk {name}")
        parts = [
            'ACTION=="add"',
            'SUBSYSTEM=="usb"',
            'ENV{DEVTYPE}=="usb_device"',
            f'ATTR{{idVendor}}=="{usb.vendor}"',
            f'ATTR{{idProduct}}=="{usb.product}"',
        ]
        if usb.serial:
            parts.append(f'ATTR{{serial}}=="{usb.serial}"')
        if usb.port:
            parts.append(f'KERNEL=="{usb.port}"')
        parts.append(f'RUN+="{systemctl} --no-block start {UNIT_NAME}"')
        by_line.setdefault(", ".join(parts), []).append(name)
    for line, desks in by_line.items():
        lines += [f"# desk {', '.join(desks)}", line]
    return "\n".join(lines) + "\n"


