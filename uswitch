def parse_m1ddc_list(text):
    """{system UUID: Edid} from `m1ddc display list detailed` (D17)."""
    displays = []
    for line in text.splitlines():
        if re.match(r"\[\d+\] ", line):
            displays.append({})
            continue
        m = re.match(r"\s*-\s*([^:]+):\s*(.*)$", line)
        if m and displays:
            value = m.group(2).strip()
            # m1ddc prints an attribute macOS didn't give it as "(null)".
            displays[-1][m.group(1).strip()] = "" if value == "(null)" else value
    found = {}
    for d in displays:
        uuid = d.get("System UUID", "")
        if not uuid:
            continue
        found[uuid] = Edid(
            mfg=d.get("Manufacturer", ""),
            model=d.get("Product name", ""),
            serial=d.get("AN Serial", ""),
            raw=b"",
            uuid=d.get("EDID UUID", ""),
        )
    return found


def _ioreg_text(entry, *keys):
    for key in keys:
        value = entry.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    return ""


def parse_ioreg_usb(data):
    """{location ID: UsbDevice} from `ioreg -a -l -p IOUSB`: every USB device
    but root hubs, as usb_devices() gives them on Linux (D17)."""
    try:
        tree = plistlib.loads(data)
    except (plistlib.InvalidFileException, xml.parsers.expat.ExpatError, ValueError) as e:
        raise UswitchError(f"can't read ioreg's USB devices: {e}")
    devices = {}
    entries = [tree]
    while entries:
        entry = entries.pop()
        if isinstance(entry, list):
            entries.extend(entry)
            continue
        if not isinstance(entry, dict):
            continue
        entries.extend(entry.get("IORegistryEntryChildren", []))
        vendor, product, location = (entry.get(k) for k in ("idVendor", "idProduct", "locationID"))
        if not all(isinstance(v, int) for v in (vendor, product, location)):
            continue  # the plane's root, or a controller rather than a device
        location &= 0xFFFFFFFF  # a T2 Mac's internal bus reports it sign-extended
        if not location & 0xFFFFFF:
            continue  # a root hub: no hub tier, and it never comes and goes with a switch
        port = f"0x{location:08x}"
        session = entry.get("sessionID")
        names = (
            _ioreg_text(entry, "USB Vendor Name", "kUSBVendorString"),
            _ioreg_text(entry, "USB Product Name", "kUSBProductString"),
        )
        devices[port] = UsbDevice(
            port=port,
            vendor=f"{vendor & 0xFFFF:04x}",
            product=f"{product & 0xFFFF:04x}",
            serial=_ioreg_text(entry, "USB Serial Number", "kUSBSerialNumberString"),
            name=" ".join(n for n in names if n),
            hub=entry.get("bDeviceClass") == 9,
            speed=IOKIT_SPEEDS.get(entry.get("Device Speed", entry.get("USBSpeed")), 0.0),
            # New for every enumeration, as Linux's device number is (D12).
            devnum=session if isinstance(session, int) else 0,
        )
    return devices


@dataclass(frozen=True)
class MacDisplay:
    """A connected monitor as m1ddc lists it, addressed by its system UUID (D17)."""

    uuid: str
    edid: Edid


class M1ddc:
    """DDC/CI through m1ddc, which a Mac addresses by system UUID (D14, D17)."""

    def __init__(self, ctx):
        self.ctx = ctx

    def run(self, args):
        try:
            return self.ctx.command(["m1ddc", *args])
        except MissingCommand:
            raise UswitchError(f"m1ddc is not installed; {M1DDC_HINT}")

    def get_input(self, display):
        """(value, None), or (None, why) when the monitor didn't answer."""
        r = self.run(["display", display.uuid, "get", "input"])
        if r.returncode != 0:
            return None, r.message()
        text = r.stdout.strip()
        if not re.fullmatch(r"-?\d+", text) or int(text) < 0:
            return None, f"unexpected m1ddc output: {text[:80]!r}"
        return int(text) & 0xFF, None

    def set_input(self, display, value):
        """None, or why the write failed."""
        r = self.run(["display", display.uuid, "set", "input", str(value)])
        return None if r.returncode == 0 else r.message()


def _touch(path):
    os.close(os.open(path, os.O_CREAT | os.O_WRONLY, 0o600))


def _take(path):
    """Whether `path` was there, removing it: a request taken exactly once."""
    try:
        os.remove(path)
    except FileNotFoundError:
        return False
    return True


class Mac:
    """Where mswitch finds monitors and DDC/CI on an Apple silicon Mac: m1ddc,
    run as the logged-in user, with everything in the user's Library (D14,
    D15, D17)."""

    name = "mswitch"
    learn_command = "mswitch learn"
    install_command = "mswitch install"
    ddc_check = "`m1ddc display list detailed`"
    power_button = False  # macOS has no hook for it (D16)

    def config_path(self, ctx):
        return os.path.join(ctx.home, MAC_DIR, "mswitch.conf")

    def wrote(self, ctx):
        return self.config_path(ctx)

    def require_privilege(self, ctx):
        if ctx.live and ctx.euid == 0:
            raise UswitchError("mswitch runs as you, not as root: run it without sudo (SPEC.md D15)")

    def can_read(self, ctx):
        return True

    def monitors(self, ctx):
        r = M1ddc(ctx).run(["display", "list", "detailed"])
        if r.returncode != 0 and "No external display" not in r.stdout:
            raise UswitchError(f"m1ddc display list failed: {r.message()}")
        # With no external display, m1ddc says so and exits non-zero: none connected.
        return [MacDisplay(uuid, edid) for uuid, edid in parse_m1ddc_list(r.stdout).items()]

    def usb_devices(self, ctx):
        r = ctx.command(["ioreg", "-a", "-l", "-p", "IOUSB"])
        if r.returncode != 0:
            raise UswitchError(f"ioreg failed: {r.message()}")
        return parse_ioreg_usb(r.stdout.encode())

    def ddc(self, ctx):
        return M1ddc(ctx)

    def power_button_woke(self, ctx):
        return False

    def write_triggers(self, ctx, config):
        pass  # the helper's trigger list arrives with it (TODO.md)

    def serialize(self, ctx, force, run):
        """One run at a time, and no trigger lost (D12, D15). Every start
        records a request before trying the lock, so a start that finds a run
        going can leave: the run that holds the lock runs again while a request
        is pending, which brings back a monitor it had already finished with,
        and looks once more after letting go, for a request that arrived in
        between."""
        directory = os.path.join(ctx.home, MAC_DIR)
        os.makedirs(directory, exist_ok=True)
        pending = os.path.join(directory, "switch.pending")
        forced = os.path.join(directory, "switch.force")
        if force:
            _touch(forced)  # before the request, so whoever takes the request sees it
        _touch(pending)
        status = 0
        while os.path.exists(pending):
            with open(os.path.join(directory, "switch.lock"), "a") as lock:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    ctx.say("A switch is already running; it takes this trigger too.")
                    return status
                try:
                    while _take(pending):
                        status = run(_take(forced))
                finally:
                    fcntl.flock(lock, fcntl.LOCK_UN)
        return status

    def install(self, ctx):
        raise UswitchError("mswitch install isn't built yet (TODO.md); `mswitch learn` and `mswitch switch` work")

    def uninstall(self, ctx, purge):
        raise UswitchError("mswitch uninstall isn't built yet (TODO.md)")


# --- Switching (D10, D11, D12) -----------------------------------------------


def present(config, connectors):
    """(monitor, connector) for each configured monitor that is connected."""
    pairs = []
    for m in config.monitors:
        for c in connectors:
            if m.matches(c.edid):
                pairs.append((m, c))
                break
    return pairs


def power_button_counts(sysfs):
    """{wakeup source: event count} for the power button's wakeup sources."""
    counts = {}
    base = os.path.join(sysfs, "class/wakeup")
    try:
        names = sorted(os.listdir(base))
    except FileNotFoundError:
        return counts
    for entry in names:
        name = _attr(os.path.join(base, entry), "name")
        count = _attr(os.path.join(base, entry), "event_count")
        if name and name.startswith(POWER_BUTTON_SOURCES) and count and count.isdigit():
            counts[name] = int(count)
    return counts


def power_button_woke(ctx):
    """Whether the power button was pressed since the last run looked (D13).

    A press while awake starts its own run through acpid, which looks too, so
    a count that grew between runs means a press that woke the machine. With
    nothing recorded, after a boot say, it says no."""
    counts = power_button_counts(ctx.sysfs)
    if not counts:
        return False
    path = ctx.path(POWER_SNAPSHOT)
    before = {}
    try:
        with open(path) as f:
            for line in f:
                name, _, count = line.strip().rpartition(" ")
                if name and count.isdigit():
                    before[name] = int(count)
    except FileNotFoundError:
        pass
    if counts != before:
        write_file(path, "".join(f"{name} {count}\n" for name, count in counts.items()))
    return any(name in before and count > before[name] for name, count in counts.items())


def desk_check(desk, devices, force):
    """Whether a desk may switch now: a desk with a switch only while the
    switch points here (D11)."""
    return force or desk.usb is None or desk.usb.present(devices)


@dataclass
class MonitorRun:
    monitor: Monitor
    seen_at: object = None
    written: bool = False
    attempt_at: object = None
    done: str = ""  # "already", "confirmed" or "unconfirmed"
    error: str = ""
    held: bool = False  # the desk check failed when it was last looked at

    def restart(self):
        """Forget every write and verdict: the switch moved, so what this run did
        or saw before no longer says where the monitor is (D12)."""
        self.done, self.written, self.attempt_at, self.error = "", False, None, ""


def switch(ctx, config, force=False, dry_run=False, power_button_only=False):
    """Switch this desk's connected monitors to this machine. Returns the exit status."""
    clock, timing = ctx.clock, ctx.timing
    start = clock.now()
    platform = ctx.platform
    if not config.monitors:
        ctx.say(f"No desk learned yet: run `{platform.learn_command}`.")
        return 0
    woke = config.power_button and not dry_run and platform.power_button_woke(ctx)
    if power_button_only and not woke:
        ctx.say("The power button didn't wake this machine: nothing to do.")
        return 0
    if woke and not force:
        ctx.say("The power button woke this machine: switching whatever the desk check says.")
        force = True
    while True:
        pairs = present(config, platform.monitors(ctx))
        if pairs or dry_run or clock.now() - start >= timing.appear:
            break
        clock.sleep(timing.poll)
    if not pairs:
        ctx.say(f"No learned monitor appeared within {timing.appear:g}s: not at a learned desk.")
        return 0
    desks = sorted({m.desk for m, _ in pairs})
    ctx.say(f"At desk {', '.join(desks)} after {clock.now() - start:.1f}s.")
    ddc = platform.ddc(ctx)
    if dry_run:
        return _dry_run(ctx, config, ddc, pairs, force)
    runs = [MonitorRun(m) for m in config.monitors if m.desk in desks]
    usb_desks = [d for d in desks if config.desks[d].usb]
    generations = {}

    def notice_presses(devices):
        """Start over every monitor at a desk whose switch went away and came back."""
        pressed = False
        for name in usb_desks:
            now_here = config.desks[name].usb.generation(devices)
            if name in generations and now_here and now_here != generations[name]:
                pressed = True
                for r in runs:
                    if r.monitor.desk == name:
                        r.restart()
            generations[name] = now_here
        return pressed

    def notice_power():
        """Like a press of the switch, a power-button press starts every monitor
        over, now past the desk check (D13). A suspend and resume during this
        run folds the resume's start into it, so every pass looks, and records
        each press even once forced, so none is left for a later run."""
        nonlocal force
        if not (config.power_button and platform.power_button_woke(ctx)):
            return False
        force = True
        for r in runs:
            r.restart()
        return True

    while True:
        if notice_power():
            ctx.say("The power button was pressed; checking the monitors again, whatever the desk check says.")
        now = clock.now()
        connectors = platform.monitors(ctx)
        devices = platform.usb_devices(ctx) if usb_desks else {}
        if notice_presses(devices):
            ctx.say("The switch went away and came back; checking the monitors again.")
        for r in runs:
            connector = next((c for c in connectors if r.monitor.matches(c.edid)), None)
            if connector is None:
                continue
            if r.seen_at is None:
                r.seen_at = now
                if now - start >= timing.poll:
                    ctx.say(f"{r.monitor.label}: reachable after {now - start:.1f}s.")
            desk = config.desks[r.monitor.desk]
            r.held = not desk_check(desk, devices, force)
            if r.held:
                # The switch moved on: start over, so a press back while the run
                # still goes lands whatever this monitor's state was (D12).
                r.restart()
            elif not r.done:
                # The snapshot above is older than the read _step makes first, so
                # it looks again right before writing (D12).
                _step(ctx, ddc, r, connector, lambda d=desk: desk_check(d, platform.usb_devices(ctx) if d.usb else {}, force))
        if clock.now() - start >= timing.run:
            break
        if all(r.done for r in runs):
            # A press away and back during the steps above would be lost once this
            # run ends, folded into it by systemd: look once more before leaving.
            pressed = bool(usb_desks) and notice_presses(platform.usb_devices(ctx))
            powered = notice_power()
            if not pressed and not powered:
                break
            if pressed:
                ctx.say("The switch went away and came back; checking the monitors again.")
            if powered:
                ctx.say("The power button was pressed; checking the monitors again, whatever the desk check says.")
            continue
        clock.sleep(timing.poll)
    status = 0
    for r in runs:
        if r.done:
            continue
        if r.seen_at is None:
            ctx.say(f"{r.monitor.label}: not connected within {timing.run:g}s; skipped.")
        elif r.held:
            ctx.say(f"{r.monitor.label}: the switch points at another machine; left alone.")
        elif r.error:
            ctx.warn(f"{r.monitor.label}: not switched: {r.error}")
            status = 1
        else:
            ctx.warn(f"{r.monitor.label}: never showed input {input_name(r.monitor.input)} within {timing.run:g}s.")
            status = 1
    return status


def _step(ctx, ddc, r, connector, may_write):
    """One look at one monitor: read before write, confirm after, and the
    desk checked again right before any write (D12). Times come from the
    clock when they're used, since a DDC/CI call can take seconds."""
    m, timing = r.monitor, ctx.timing
    value, why = ddc.get_input(connector)
    now = ctx.clock.now()
    if value == m.input:
        if r.attempt_at is not None:
            r.done = "confirmed"
            ctx.say(f"{m.label}: showing {input_name(m.input)}, confirmed {now - r.attempt_at:.1f}s after writing.")
        else:
            r.done = "already"
            ctx.say(f"{m.label}: already showing {input_name(m.input)}.")
        return
    if r.attempt_at is not None and now - r.attempt_at < timing.settle:
        return  # still settling after the last attempt
    if r.written and value is None:
        r.done = "unconfirmed"
        ctx.say(f"{m.label}: wrote {input_name(m.input)}; it doesn't answer reads to confirm ({why}).")
        return
    if not may_write():
        r.held = True
        return
    shown = "no answer" if value is None else input_name(value)
    ctx.say(f"{m.label}: {shown}; writing {input_name(m.input)}.")
    error = ddc.set_input(connector, m.input)
    r.attempt_at = ctx.clock.now()  # the monitor starts settling once the write is done
    if error:
        r.error = error
        ctx.warn(f"{m.label}: write failed: {error}")
    else:
        r.written = True
        r.error = ""


def _dry_run(ctx, config, ddc, pairs, force):
    devices = ctx.platform.usb_devices(ctx)
    for m, c in pairs:
        desk = config.desks[m.desk]
        value, why = ddc.get_input(c)
        if not desk_check(desk, devices, force):
            plan = "would leave it: the switch points at another machine"
        elif value == m.input:
            plan = "already showing this machine"
        else:
            plan = f"would write {input_name(m.input)}"
        shown = input_name(value) if value is not None else f"no answer ({why})"
        ctx.say(f"{m.label}: {shown}; {plan}.")
    return 0


# --- Learning (D2) -----------------------------------------------------------


def _next_desk_name(config):
    n = 1
    while f"desk{n}" in config.desks:
        n += 1
    return f"desk{n}"


def watch_press(ctx, before):
    """Wait for devices to leave and come back; returns those that did."""
    clock, timing = ctx.clock, ctx.timing
    start = clock.now()
    gone = {}
    while not gone:
        if clock.now() - start >= timing.learn_press:
            raise UswitchError(f"no USB device left within {timing.learn_press:g}s; was the switch pressed?")
        clock.sleep(timing.poll)
        current = ctx.platform.usb_devices(ctx)
        gone = {p: d for p, d in before.items() if current.get(p) != d}
    first_back = None
    while True:
        current = ctx.platform.usb_devices(ctx)
        gone.update({p: d for p, d in before.items() if current.get(p) != d})
        back = [d for p, d in gone.items() if current.get(p) == d]
        now = clock.now()
        if back and first_back is None:
            first_back = now
        if back and len(back) == len(gone):
            return back
        if first_back is not None and now - first_back >= timing.learn_return_grace:
            return back
        if now - start >= 2 * timing.learn_press:
            raise UswitchError("the USB devices didn't come back; press the switch back to this machine and rerun learn")
        clock.sleep(timing.poll)


def _pick(ctx, devices, why):
    if len(devices) == 1:
        return devices[0]
    ctx.say(why)
    for i, d in enumerate(devices, 1):
        ctx.say(f"  {i}. {d.describe()}")
    while True:
        answer = ctx.ask("Which one?", "1")
        if answer.isdigit() and 1 <= int(answer) <= len(devices):
            return devices[int(answer) - 1]
        ctx.say(f"Answer a number from 1 to {len(devices)}.")


def _usb_from_spec(ctx, spec, devices):
    parts = spec.split(":", 2)
    ids = [p.lower() for p in parts[:2]]
    if len(parts) < 2 or not all(HEX4.fullmatch(p) for p in ids):
        raise UswitchError("--usb takes VENDOR:PRODUCT or VENDOR:PRODUCT:SERIAL, in hex", code=2)
    wanted = UsbTrigger(ids[0], ids[1], parts[2] if len(parts) == 3 else "")
    matches = sorted((d for d in devices.values() if wanted.matches(d)), key=lambda d: d.port)
    if not matches:
        raise UswitchError(f"no USB device {wanted.describe()} is connected; point the switch at this machine")
    return _pick(ctx, matches, "More than one device matches; pick the switch's own:")


def _prove(ctx, ddc, pairs, label_away):
    """Step 4: from an input the monitors aren't showing, switch them back."""
    clock, timing = ctx.clock, ctx.timing
    start = clock.now()
    away = set()
    while len(away) < len(pairs) and clock.now() - start < timing.learn_away:
        for m, c in pairs:
            if m.label in away:
                continue
            value, _ = ddc.get_input(c)
            if value != m.input:
                away.add(m.label)  # another input, or no answer on an input it isn't showing
        if len(away) < len(pairs):
            clock.sleep(timing.poll)
    for m, c in pairs:
        error = ddc.set_input(c, m.input)
        if error:
            ctx.warn(f"{m.label}: write failed: {error}")
    start = clock.now()
    pending = {m.label for m, _ in pairs}
    while pending and clock.now() - start < timing.settle:
        for m, c in pairs:
            if m.label in pending and ddc.get_input(c)[0] == m.input:
                pending.discard(m.label)
        if pending:
            clock.sleep(timing.poll)
    ok = True
    for m, _ in pairs:
        if m.label in pending:
            ok = False
            ctx.warn(f"{m.label}: didn't come back. Use its buttons; it can't be switched from an inactive input (SPEC.md Phase 0 step 3).")
        elif m.label in away:
            ctx.say(f"{m.label}: {label_away}")
        else:
            ctx.say(f"{m.label}: never left this machine's input, so switching from another input is untested.")
    return ok


def learn(ctx, desk_name=None, usb_spec=None):
    platform = ctx.platform
    platform.require_privilege(ctx)
    config_path = platform.config_path(ctx)
    config = load_config(config_path) or Config()
    ddc = platform.ddc(ctx)
    pairs = []
    for c in platform.monitors(ctx):
        probe = monitor_from_edid(c.edid, "", 0)
        if any(m.same_monitor(probe) for m, _ in pairs):
            ctx.warn(f"{probe.label}: identical to another connected monitor, with no serial to tell them apart; skipping it.")
            continue
        value, why = ddc.get_input(c)
        if value is None:
            ctx.say(f"{probe.label}: doesn't answer DDC/CI ({why}); skipping it.")
            continue
        probe.input = value
        ctx.say(f"{probe.label}: showing {input_name(value)}, this machine's input.")
        pairs.append((probe, c))
    if not pairs:
        raise UswitchError(f"no connected monitor answers DDC/CI; check its DDC/CI setting and {platform.ddc_check}")
    monitors = [m for m, _ in pairs]
    owners = sorted({o.desk for o in config.monitors for m in monitors if o.same_monitor(m)})
    if desk_name is None:
        desk_name = ctx.ask("Name this desk:", owners[0] if len(owners) == 1 else _next_desk_name(config))
    if not DESK_NAME.fullmatch(desk_name):
        raise UswitchError("desk names are letters, digits, '.', '_' and '-'", code=2)
    devices = platform.usb_devices(ctx)
    if usb_spec:
        setup_a = True
    else:
        while True:
            answer = ctx.ask("Does this desk have a USB switch (a), or is a monitor its own switch (b)?", "a").lower()
            if answer in ("a", "b"):
                break
        setup_a = answer == "a"
    away_hint = (
        f"After pressing it back, if the monitors didn't follow to the other machine, switch each one\n"
        f"to another input with its buttons within {ctx.timing.learn_away:g}s; {platform.name} switches it back."
    )
    usb = None
    if setup_a and usb_spec:
        usb = trigger_for(_usb_from_spec(ctx, usb_spec, devices), devices)
        ctx.say(f"Within {ctx.timing.learn_away:g}s, switch each monitor to another input with its buttons;")
        ctx.say(f"{platform.name} then switches it back.")
        ctx.ask("Press Enter to start.")
    elif setup_a:
        ctx.say("Press the USB switch to another machine, then press it back. The screen and keyboard")
        ctx.say("may go to the other machine in between; nothing here needs a key until they're back.")
        ctx.say(away_hint)
        ctx.ask("Press Enter, then press the switch.")
        returned = watch_press(ctx, platform.usb_devices(ctx))
        devices = platform.usb_devices(ctx)
        device = _pick(ctx, trigger_candidates(returned), "More than one device came and went with the switch; pick its own hub:")
        usb = trigger_for(device, devices)
    else:
        ctx.say(f"Within {ctx.timing.learn_away:g}s, switch each monitor to another input with its buttons. Its KVM")
        ctx.say(f"takes the keyboard with it; {platform.name} switches it back, and the keyboard returns.")
        ctx.ask("Press Enter to start.")
    if usb:
        pinned = " (port pinned: the ID alone isn't unique, or its serial isn't safe to match)" if usb.port else ""
        ctx.say(f"Trigger: {usb.describe()}{pinned}.")
    config = replace_desk(config, desk_name, usb, monitors)
    write_file(config_path, config_text(config, platform))
    platform.write_triggers(ctx, config)
    ctx.say(f"Wrote desk {desk_name} to {platform.wrote(ctx)}.")
    ok = _prove(ctx, ddc, pairs, "switched back from another input.")
    return 0 if ok else 1


def systemctl_path(ctx):
    return ctx.which("systemctl") or "/usr/bin/systemctl"


def write_rules(ctx, config):
    write_file(ctx.path(UDEV_RULE), udev_rules_text(config, systemctl_path(ctx)))
    if ctx.live:
        _check(ctx, ["udevadm", "control", "--reload"])


def _check(ctx, argv):
    try:
        r = ctx.command(argv)
    except MissingCommand as e:
        raise UswitchError(str(e))
    if r.returncode != 0:
        raise UswitchError(f"{' '.join(argv)} failed: {r.message()}")


def _systemctl(ctx, *args):
    root = [] if ctx.live else ["--root", ctx.root]
    _check(ctx, ["systemctl", *root, *args])


# --- Install and uninstall (D9) ----------------------------------------------


def other_power_handlers(ctx):
    """acpid event files besides uswitch's that act on the power button (D13)."""
    events = ctx.path(os.path.dirname(ACPID_EVENT))
    try:
        names = sorted(os.listdir(events))
    except FileNotFoundError:
        return []
    found = []
    for name in names:
        path = os.path.join(events, name)
        if name == os.path.basename(ACPID_EVENT) or not ACPID_FILE_NAME.fullmatch(name) or not os.path.isfile(path):
            continue
        for line in _read(path).splitlines():
            key, _, pattern = line.strip().partition("=")
            if key.strip() != "event":
                continue
            try:
                matches = re.search(pattern.strip(), ACPID_POWER_EVENT)
            except re.error:
                matches = True  # a pattern Python can't read: assume the worst
            if matches:
                found.append(f"/{os.path.relpath(path, ctx.root)}")
                break
    return found


POWER_FILES = (POWER_UNIT, POWER_WAKE_UNIT, ACPID_EVENT, LOGIND_DROPIN)


def _check_power_button(ctx):
    """Refuse, before writing anything, what would make the power button unsafe (D13)."""
    if ctx.which("acpid") is None:
        raise UswitchError(f"acpid is not installed; {ACPID_PACKAGE_HINT}")
    others = other_power_handlers(ctx)
    if others:
        raise UswitchError(
            f"acpid also acts on the power button in {', '.join(others)}, and may power off "
            "the machine; move it out of /etc/acpi/events, or set [power_button] enabled = no "
            "in /etc/uswitch.conf, then rerun install"
        )


def _install_power_button(ctx, on):
    """Hand the power button to acpid and uswitch, or take it back (D13)."""
    if on:
        write_file(ctx.path(ACPID_EVENT), acpid_event_text(systemctl_path(ctx)))
        write_file(ctx.path(LOGIND_DROPIN), LOGIND_TEXT)
        _systemctl(ctx, "enable", "acpid.service")
        if ctx.live:
            _check(ctx, ["systemctl", "restart", "acpid.service"])
            _reload_logind(ctx)
        return []
    if os.path.exists(ctx.path(POWER_WAKE_UNIT)):
        _systemctl(ctx, "disable", POWER_WAKE_UNIT_NAME)
    removed = _remove(ctx, POWER_FILES)
    if ctx.live and removed:
        _check(ctx, ["systemctl", "daemon-reload"])
        _check(ctx, ["systemctl", "try-restart", "acpid.service"])
        _reload_logind(ctx)
    return removed


def _reload_logind(ctx):
    """logind rereads HandlePowerKey on reload where it supports one; restarting
    it can end sessions, so otherwise the change waits for the next boot."""
    r = ctx.command(["systemctl", "show", "--property=CanReload", "--value", "systemd-logind.service"])
    if r.returncode == 0 and r.stdout.strip() == "yes":
        _check(ctx, ["systemctl", "reload", "systemd-logind.service"])
    else:
        ctx.say("The power-button setting for logind takes effect at the next boot.")


def _remove(ctx, rels):
    removed = []
    for rel in rels:
        try:
            os.remove(ctx.path(rel))
            removed.append(f"/{rel}")
        except FileNotFoundError:
            pass  # already gone: uninstall is idempotent
    return removed


def install(ctx):
    require_root(ctx)
    if ctx.which("ddcutil") is None:
        raise UswitchError(f"ddcutil is not installed; {DDCUTIL_PACKAGE_HINT}")
    config = load_config(ctx.path(CONFIG))
    power_button = config.power_button if config is not None else True
    if power_button:
        _check_power_button(ctx)
    program = ctx.path(PROGRAM)
    if not (os.path.exists(program) and os.path.samefile(ctx.self_path, program)):
        os.makedirs(os.path.dirname(program), exist_ok=True)
        write_file(program, _read(ctx.self_path), 0o755)
    write_file(ctx.path(UNIT), unit_text())
    write_file(ctx.path(POLKIT_RULE), POLKIT_TEXT)
    write_file(ctx.path(MODULES_LOAD), MODULES_LOAD_TEXT)
    if power_button:
        write_file(ctx.path(POWER_UNIT), power_unit_text())
        write_file(ctx.path(POWER_WAKE_UNIT), power_wake_unit_text())
    if ctx.live:
        _check(ctx, ["modprobe", "i2c-dev"])
        _check(ctx, ["systemctl", "daemon-reload"])
    # After the reload, so the unit acpid starts is loaded by then.
    _install_power_button(ctx, power_button)
    if config is not None:
        write_rules(ctx, config)
    wake = config.wake if config is not None else True
    _systemctl(ctx, "enable" if wake else "disable", UNIT_NAME)
    if power_button:
        # With wake on, the main unit's resume run looks for the press (D13).
        _systemctl(ctx, "disable" if wake else "enable", POWER_WAKE_UNIT_NAME)
    ctx.say(
        f"Installed /{PROGRAM}, {UNIT_NAME} (wake {'on' if wake else 'off'}, "
        f"power button {'on' if power_button else 'off'}), its polkit rule and i2c-dev loading."
    )
    if config is None:
        ctx.say("No desk learned yet; running `uswitch learn`.")
        return learn(ctx)
    return 0


def uninstall(ctx, purge=False):
    require_root(ctx)
    if os.path.exists(ctx.path(UNIT)):
        _systemctl(ctx, "disable", UNIT_NAME)
    removed = _install_power_button(ctx, False)
    paths = [UDEV_RULE, UNIT, POLKIT_RULE, MODULES_LOAD, PROGRAM] + ([CONFIG] if purge else [])
    removed += _remove(ctx, paths)
    if ctx.live:
        _check(ctx, ["systemctl", "daemon-reload"])
        _check(ctx, ["udevadm", "control", "--reload"])
    ctx.say("Removed " + (", ".join(removed) if removed else "nothing; uswitch wasn't installed") + ".")
    if not purge and os.path.exists(ctx.path(CONFIG)):
        ctx.say(f"Kept /{CONFIG}; `uninstall --purge` removes it too.")
    return 0


# --- Status -------------------------------------------------------------------


def status(ctx):
    platform = ctx.platform
    config = load_config(platform.config_path(ctx))
    if config is None:
        ctx.say(f"No desk learned yet: run `{platform.learn_command}`.")
        return 0
    connectors = platform.monitors(ctx)
    devices = platform.usb_devices(ctx)
    pairs = dict((m.label, c) for m, c in present(config, connectors))
    can_read = platform.can_read(ctx)
    ddc = platform.ddc(ctx)
    ctx.say(f"wake: {'on' if config.wake else 'off'}")
    if platform.power_button:
        ctx.say(f"power button: {'on' if config.power_button else 'off'}")
    for name in sorted(config.desks):
        desk = config.desks[name]
        here = any(m.label in pairs for m in config.monitors_of(name))
        if desk.usb:
            setup = f"USB switch {desk.usb.describe()}, {'present' if desk.usb.present(devices) else 'not present'}"
        else:
            setup = "the monitor is the switch"
        ctx.say(f"desk {name}{' (connected)' if here else ''}: {setup}")
        for m in config.monitors_of(name):
            c = pairs.get(m.label)
            if c is None:
                state = "not connected"
            elif not can_read:
                state = "connected (current input needs sudo)"
            else:
                value, why = ddc.get_input(c)
                state = f"showing {input_name(value)}" if value is not None else f"no answer ({why})"
            ctx.say(f"  {m.label}: this machine is {input_name(m.input)}; {state}")
    return 0


# --- Command line -------------------------------------------------------------


def parse_args(argv, prog="uswitch"):
    parser = argparse.ArgumentParser(prog=prog, description="Switch monitors to this machine over DDC/CI.")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("install", help="install, then learn if no desk is learned (D9)")
    p = sub.add_parser("uninstall", help="remove what install and learn wrote (D9)")
    p.add_argument("--purge", action="store_true", help="remove the configuration too")
    p = sub.add_parser("learn", help="learn this desk's trigger and monitor inputs (D2)")
    p.add_argument("--desk", metavar="NAME", help="the desk's name")
    p.add_argument("--usb", metavar="VENDOR:PRODUCT[:SERIAL]", help="name the switch's hub instead of pressing it")
    p = sub.add_parser("switch", help="switch the connected monitors to this machine (D10)")
    p.add_argument("--dry-run", action="store_true", help="say what would change, and change nothing")
    p.add_argument("--force", action="store_true", help="skip the desk check (D11)")
    p.add_argument("--power-button-only", action="store_true", help="switch only if the power button woke this machine (D13)")
    sub.add_parser("status", help="show desks, triggers and monitor inputs")
    return parser.parse_args(argv)


def main(argv=None, ctx=None):
    ctx = ctx or Context()
    args = parse_args(sys.argv[1:] if argv is None else argv, ctx.platform.name)
    try:
        if args.command == "install":
            return ctx.platform.install(ctx)
        if args.command == "uninstall":
            return ctx.platform.uninstall(ctx, args.purge)
        if args.command == "learn":
            return learn(ctx, args.desk, args.usb)
        if args.command == "switch":
            ctx.platform.require_privilege(ctx)
            config = load_config(ctx.platform.config_path(ctx)) or Config()
            if args.dry_run:
                return switch(ctx, config, force=args.force, dry_run=True)
            return ctx.platform.serialize(
                ctx,
                args.force,
                lambda force: switch(ctx, config, force=force, power_button_only=args.power_button_only),
            )
        return status(ctx)
    except UswitchError as e:
        ctx.warn(str(e))
        return e.code
    except OSError as e:
        ctx.warn(f"{e.filename or 'file'}: {e.strerror or e}")
        return 1
    except KeyboardInterrupt:
        ctx.warn("interrupted")
        return 130


if __name__ == "__main__":
    sys.exit(main())
